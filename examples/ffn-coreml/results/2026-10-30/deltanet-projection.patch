+// DeltaNet input projections [attn_qkv; attn_gate]: Metal computes qkv rows [0, gpu_rows), Core ML the remaining rows
+struct decoder_proj {
+    temporary_model compiled{nil};
+    temporary_model compiled2{nil};
+    MLModel * model = nil;
+    MLModel * model2 = nil;
+    MLMultiArray * input = nil;
+    MLDictionaryFeatureProvider * features = nil;
+    ggml_context * weight_ctx = nullptr;
+    ggml_context * graph_ctx = nullptr;
+    ggml_backend_buffer_t weights = nullptr;
+    ggml_gallocr_t alloc = nullptr;
+    ggml_cgraph * graph = nullptr;
+    decoder_proj_io * io = nullptr;
+    std::vector<ggml_tensor *> out_views;
+    int64_t qkv_rows = 0, z_rows = 0, gpu_rows = 0;
+    int64_t start[2] = {}, count[2] = {};
+    bool full_metal = false;
+    uint64_t calls = 0;
+    std::string error;
+
+    ~decoder_proj() {
+        ggml_gallocr_free(alloc);
+        ggml_backend_buffer_free(weights);
+        ggml_free(graph_ctx);
+        ggml_free(weight_ctx);
+    }
+
+    void read_slice(const std::string & gguf, gguf_context * header, ggml_tensor * source, ggml_tensor * target) {
+        std::vector<char> bytes(ggml_nbytes(target));
+        size_t offset = gguf_get_data_offset(header) + gguf_get_tensor_offset(header, gguf_find_tensor(header, source->name));
+        read_at(gguf, offset, bytes.data(), bytes.size());
+        ggml_backend_tensor_set(target, bytes.data(), 0, bytes.size());
+    }
+
+    void init(const std::string & gguf, const std::string & assets, int layer, bool reference_only, decoder_proj_io & shared) {
+        full_metal = reference_only;
+        io = &shared;
+        ggml_context * meta = nullptr;
+        gguf_context * header = gguf_init_from_file(gguf.c_str(), {true, &meta});
+        require(header && meta, "could not read GGUF header");
+        auto * qkv = ggml_get_tensor(meta, ("blk." + std::to_string(layer) + ".attn_qkv.weight").c_str());
+        auto * gate = ggml_get_tensor(meta, ("blk." + std::to_string(layer) + ".attn_gate.weight").c_str());
+        require(qkv && gate && qkv->ne[0] == 5120 && gate->ne[0] == 5120, "missing DeltaNet input projections");
+        qkv_rows = qkv->ne[1];
+        z_rows = gate->ne[1];
+        gpu_rows = qkv_rows;
+        if (!full_metal) {
+            model = decoder_load(assets, "proj-512", layer, compiled);
+            NSDictionary * metadata = model.modelDescription.metadata[MLModelCreatorDefinedKey];
+            start[0] = [metadata[@"row_start"] longLongValue];
+            count[0] = [metadata[@"row_count"] longLongValue];
+            require([metadata[@"source_layer"] intValue] == layer, "projection package is for a different layer");
+            if (decoder_has_model(assets, "proj-512-1")) {
+                model2 = decoder_load(assets, "proj-512-1", layer, compiled2);
+                NSDictionary * metadata2 = model2.modelDescription.metadata[MLModelCreatorDefinedKey];
+                start[1] = [metadata2[@"row_start"] longLongValue];
+                count[1] = [metadata2[@"row_count"] longLongValue];
+                require([metadata2[@"source_layer"] intValue] == layer && start[1] == start[0] + count[0], "second projection package must follow the first");
+            }
+            gpu_rows = start[0];
+            require(gpu_rows > 0 && gpu_rows <= qkv_rows && count[0] > 0 && start[0] + count[0] + count[1] == qkv_rows + z_rows, "projection packages must cover the rows after the Metal part");
+        }
+        shared.ensure(qkv_rows + z_rows);
+        weight_ctx = ggml_init({ggml_tensor_overhead() * 2, nullptr, true});
+        auto * w_qkv = ggml_new_tensor_2d(weight_ctx, qkv->type, 5120, gpu_rows);
+        auto * w_z = full_metal ? ggml_new_tensor_2d(weight_ctx, gate->type, 5120, z_rows) : nullptr;
+        auto buft = ggml_backend_dev_buffer_type(ggml_backend_dev_by_name("MTL0"));
+        weights = ggml_backend_alloc_ctx_tensors_from_buft(weight_ctx, buft);
+        require(weights, "could not allocate projection weights");
+        ggml_backend_buffer_set_usage(weights, GGML_BACKEND_BUFFER_USAGE_WEIGHTS);
+        read_slice(gguf, header, qkv, w_qkv);
+        if (w_z) { read_slice(gguf, header, gate, w_z); }
+        gguf_free(header);
+        ggml_free(meta);
+        graph_ctx = ggml_init({ggml_tensor_overhead() * 16 + ggml_graph_overhead_custom(16, false), nullptr, true});
+        graph = ggml_new_graph_custom(graph_ctx, 16, false);
+        auto * qkv_view = ggml_view_2d(graph_ctx, shared.out, gpu_rows, 512, qkv_rows * sizeof(float), 0);
+        ggml_build_forward_expand(graph, ggml_cpy(graph_ctx, ggml_mul_mat(graph_ctx, w_qkv, shared.x), qkv_view));
+        if (w_z) {
+            auto * z_view = ggml_view_2d(graph_ctx, shared.out, z_rows, 512, z_rows * sizeof(float), qkv_rows * 512 * sizeof(float));
+            ggml_build_forward_expand(graph, ggml_cpy(graph_ctx, ggml_mul_mat(graph_ctx, w_z, shared.x), z_view));
+        }
+        alloc = ggml_gallocr_new(buft);
+        require(ggml_gallocr_alloc_graph(alloc, graph), "could not allocate projection graph");
+        for (int i = 0; i < ggml_graph_n_nodes(graph); ++i) {
+            auto * node = ggml_graph_node(graph, i);
+            for (int j = -1; j < GGML_MAX_SRC; ++j) {
+                auto * t = j < 0 ? node : node->src[j];
+                if (t && t->view_src == shared.out && std::find(out_views.begin(), out_views.end(), t) == out_views.end()) { out_views.push_back(t); }
+            }
+        }
+        printf("decoder_proj_layer=%d metal_rows=%lld coreml_rows=%lld+%lld\n", layer, (long long) gpu_rows, (long long) count[0], (long long) count[1]);
+    }
+
+    void predict(float * dst) {
+        __block id<MLFeatureProvider> second = nil;
+        __block NSError * second_failure = nil;
+        dispatch_group_t group = dispatch_group_create();
+        if (model2) {
+            MLModel * other = model2;
+            MLDictionaryFeatureProvider * inputs = features;
+            dispatch_group_async(group, dispatch_get_global_queue(QOS_CLASS_USER_INTERACTIVE, 0), ^{
+                @autoreleasepool {
+                    NSError * failure = nil;
+                    second = [other predictionFromFeatures:inputs error:&failure];
+                    second_failure = failure;
+                }
+            });
+        }
+        NSError * failure = nil;
+        id<MLFeatureProvider> result = [model predictionFromFeatures:features error:&failure];
+        dispatch_group_wait(group, DISPATCH_TIME_FOREVER);
+        require(result, failure ? failure.localizedDescription.UTF8String : "projection prediction failed");
+        require(!model2 || second, second_failure ? second_failure.localizedDescription.UTF8String : "second projection prediction failed");
+        id<MLFeatureProvider> results[2] = {result, second};
+        for (int p = 0; p < (model2 ? 2 : 1); ++p) {
+            MLMultiArray * y = [results[p] featureValueForName:@"y"].multiArrayValue;
+            require(y && y.dataType == MLMultiArrayDataTypeFloat32 && y.shape.count == 2 && y.shape[0].intValue == 512 && y.shape[1].longLongValue == count[p], "unexpected projection output");
+            const float * values = static_cast<const float *>(y.dataPointer);
+            size_t row_stride = y.strides[0].unsignedLongLongValue, column_stride = y.strides[1].unsignedLongLongValue;
+            for (int t = 0; t < 512; ++t) {
+                for (int64_t c = 0; c < count[p]; ++c) {
+                    const float value = values[t * row_stride + c * column_stride];
+                    if (!std::isfinite(value)) { throw std::runtime_error("non-finite projection output"); }
+                    const int64_t row = start[p] + c;
+                    if (row < qkv_rows) { dst[t * qkv_rows + row] = value; } else { dst[qkv_rows * 512 + t * z_rows + row - qkv_rows] = value; }
+                }
+            }
+        }
+    }
+};
