     int batch_threads = 20;
 
     uint64_t calls() const {
         uint64_t count = 0;
         for (const auto & entry : layers) { count += entry.second->calls; }
+        for (const auto & entry : projs) { count += entry.second->calls; }
         return count;
     }
 
+    // offload calls expected per 512-token chunk
+    uint64_t offloads() const { return layers.size() + projs.size(); }
+
     void check() const {
         for (const auto & entry : layers) { require(entry.second->error.empty(), entry.second->error); }
+        for (const auto & entry : projs) { require(entry.second->error.empty(), entry.second->error); }
     }
 };
 
