+// placeholder input/output for the projection graphs, rebound to scheduler tensors before every call
+struct decoder_proj_io {
+    ggml_context * ctx = nullptr;
+    ggml_backend_buffer_t buffer = nullptr;
+    ggml_tensor * x = nullptr;
+    ggml_tensor * out = nullptr;
+
+    ~decoder_proj_io() {
+        ggml_backend_buffer_free(buffer);
+        ggml_free(ctx);
+    }
+
+    void ensure(int64_t rows) {
+        if (out) { require(ggml_nelements(out) == rows * 512, "projection rows differ between layers"); return; }
+        ctx = ggml_init({ggml_tensor_overhead() * 2, nullptr, true});
+        x = ggml_new_tensor_2d(ctx, GGML_TYPE_F32, 5120, 512);
+        out = ggml_new_tensor_1d(ctx, GGML_TYPE_F32, rows * 512);
+        buffer = ggml_backend_alloc_ctx_tensors_from_buft(ctx, ggml_backend_dev_buffer_type(ggml_backend_dev_by_name("MTL0")));
+        require(buffer, "could not allocate projection placeholders");
+    }
+};
