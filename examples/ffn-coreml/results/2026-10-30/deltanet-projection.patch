+static ggml_tensor * decoder_proj_build(ggml_context * ctx, ggml_tensor * input, int64_t qkv_rows, int64_t z_rows, int layer, void * userdata) {
+    auto & state = *static_cast<decoder_state *>(userdata);
+    auto found = state.projs.find(layer);
+    if (found == state.projs.end() || input->type != GGML_TYPE_F32 || input->ne[0] != 5120 || input->ne[1] != 512 || input->ne[2] != 1 || input->ne[3] != 1) { return nullptr; }
+    if (qkv_rows != found->second->qkv_rows || z_rows != found->second->z_rows) { return nullptr; }
+    ggml_tensor * args[] = {input};
+    return ggml_custom_4d(ctx, GGML_TYPE_F32, (qkv_rows + z_rows) * 512, 1, 1, 1, args, 1, decoder_proj_compute, 1, found->second.get());
+}
