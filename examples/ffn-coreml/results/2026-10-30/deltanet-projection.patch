+static void decoder_proj_compute(ggml_tensor * dst, int ith, int nth, void * userdata) {
+    if (ith != 0) { return; }
+    static_cast<decoder_proj *>(userdata)->error = "projection offload requires FFN_COREML_GPU_RESIDENT";
+    std::fill_n(static_cast<float *>(dst->data), ggml_nelements(dst), NAN);
+}
+
+static bool decoder_proj_resident(ggml_backend_t backend, ggml_tensor * dst, void * userdata) {
+    auto & runtime = *static_cast<decoder_proj *>(userdata);
+    @autoreleasepool {
+        try {
+            const auto * src = dst->src[0];
+            require(src->data != dst->data && ggml_is_contiguous(dst), "unexpected projection layout");
+            if (!runtime.full_metal) { ggml_backend_synchronize(backend); }
+            bind_resident_tensor(runtime.io->x, src);
+            bind_resident_tensor(runtime.io->out, dst);
+            for (auto * view : runtime.out_views) {
+                view->buffer = dst->buffer;
+                view->data = static_cast<char *>(dst->data) + view->view_offs;
+            }
+            require(ggml_backend_graph_compute_async(backend, runtime.graph) == GGML_STATUS_SUCCESS, "projection Metal part failed");
+            if (!runtime.full_metal) {
+                require(ggml_backend_metal_tensor_is_shared(src) && ggml_backend_metal_tensor_is_shared(dst), "projection tensors must use shared Metal storage");
+                if (runtime.input.dataPointer != src->data) {
+                    NSError * failure = nil;
+                    runtime.input = [[MLMultiArray alloc] initWithDataPointer:src->data shape:@[@512, @5120] dataType:MLMultiArrayDataTypeFloat32 strides:@[@5120, @1] deallocator:nil error:&failure];
+                    require(runtime.input, "projection input binding failed");
+                    runtime.features = [[MLDictionaryFeatureProvider alloc] initWithDictionary:@{@"x": runtime.input} error:&failure];
+                    require(runtime.features, "projection provider failed");
+                }
+                // Metal writes qkv rows [0, gpu_rows); the CPU writes only the remaining rows
+                runtime.predict(static_cast<float *>(dst->data));
+            }
+            ++runtime.calls;
+            return true;
+        } catch (const std::exception & failure) {
+            runtime.error = failure.what();
+            ggml_backend_synchronize(backend);
+            fprintf(stderr, "resident projection failed: %s\n", failure.what());
+            return false;
+        }
+    }
+}
