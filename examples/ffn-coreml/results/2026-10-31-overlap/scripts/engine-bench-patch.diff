     # context checkpoints: both copy state around requests and would skew the timings
     LLAMA_GDN_DEFERRED=1 $BIN/llama-server -m $Q0 -ngl 99 -fa on --port $PORT --no-cache-prompt -cram 0 -ctxcp 0 --no-webui \
         -np ${NP:-32} -kvu -c ${CTX:-65536} ${SPEC[@]+"${SPEC[@]}"} > $LOG 2>&1 & ;;
+  fabcml)
+    # qvac-fabric with the Core ML FFN sidecar on both Neural Engines (prefill only; same flags as fab)
+    SPEC=()
+    case $MODE in
+      ar) ;;
+      dflash2) SPEC=(-md $QD -ngld 99 --spec-type draft-dflash --spec-draft-n-max 7) ;;
+      *) unsupported ;;
+    esac
+    # FABCML_ENV: extra environment (for example the half-batch overlap), FABCML_EXTRA: extra server flags
+    env LLAMA_GDN_DEFERRED=1 ${FABCML_ENV:-} FFN_COREML_ASSETS=$CML_ASSETS FFN_COREML_GPU_RESIDENT=1 FFN_COREML_SINGLE_ENCODER=1 \
+    FFN_COREML_CACHE_COMPILED=1 $FABCML_BIN/llama-server-coreml -m $Q0 -ngl 99 -fa on --port $PORT --no-cache-prompt -cram 0 -ctxcp 0 --no-webui \
+        -np ${NP:-32} -kvu -c ${CTX:-65536} ${SPEC[@]+"${SPEC[@]}"} ${FABCML_EXTRA:-} > $LOG 2>&1 & ;;
   mlx)
     [ $MODE = ar ] || unsupported
     $MLX_PY -m mlx_lm.server --model $X --port $PORT --max-tokens 4096 > $LOG 2>&1 & ;;
@@ -76,7 +88,7 @@
