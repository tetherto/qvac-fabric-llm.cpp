+        return 0;
+    }
+    const ggml_tensor * upd_root = upd->view_src ? upd->view_src : upd;
+    if (upd_root != cache || upd->type != GGML_TYPE_F32 || upd->ne[0] != state_size || upd->ne[1] != n_seqs || upd->ne[2] != 1 || upd->ne[3] != 1 ||
+        upd->nb[0] != sizeof(float) || upd->nb[1] % sizeof(float) != 0) {
+        return 0;
+    }
