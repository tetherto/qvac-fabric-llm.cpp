+    a.cache         = (float *) upd->data;
+    a.states_stride = states->nb[1]/sizeof(float);
+    a.x_stride_t    = xt->nb[0]/sizeof(float);
+    a.x_stride_s    = xt->nb[2]/sizeof(float);
+    a.cache_stride  = upd->nb[1]/sizeof(float);
+    return count - 1;
+}
