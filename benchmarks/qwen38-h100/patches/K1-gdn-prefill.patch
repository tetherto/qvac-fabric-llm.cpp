+    float         * cache;         // [n_ch][d_conv-1] the next state row (may be the row states[idx[0]])
+    int64_t states_stride;
+    int64_t x_stride_t;
+    int64_t w_stride;
+    int     n_ch;
+    int     d_conv;                // 3, 4, 5 or 9
+    int     n_t;                   // > GGML_CUDA_CONV_STATE_MAX_T
+};
