diff --git a/ggml/src/ggml-cuda/ssm-conv.cu b/ggml/src/ggml-cuda/ssm-conv.cu
index 0e23ea743..964232b67 100644
--- a/ggml/src/ggml-cuda/ssm-conv.cu
+++ b/ggml/src/ggml-cuda/ssm-conv.cu
@@ -1,4 +1,5 @@
 #include "common.cuh"
+#include "conv-state.cuh"
 #include "ssm-conv.cuh"
 #include "unary.cuh"
 
@@ -257,3 +258,102 @@ void ggml_cuda_op_ssm_conv(ggml_backend_cuda_context & ctx, ggml_tensor * dst, g
