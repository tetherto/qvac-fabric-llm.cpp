+template <int ncols_dst, int nrows_w, bool y_vec, bool has_glu>
+static __global__ void mul_mat_vec_f8_e4m3(
+        const uint8_t * x, const float * sx, const uint8_t * xg, const float * sxg,
+        const float * y, float * dst,
