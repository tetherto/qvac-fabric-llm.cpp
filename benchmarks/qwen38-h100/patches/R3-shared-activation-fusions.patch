+    GGML_ASSERT(n >= 2 && n <= MMF8_MULTI_MAX);
+    const ggml_tensor * src1 = dsts[0]->src[1];
+    const int     ncols   = src1->ne[0];
+    const int64_t ntokens = ggml_nrows(src1);
