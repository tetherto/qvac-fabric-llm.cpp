+            out_idx[r] = j;
+            l2.ch0[r]   = off/sizeof(float);
+            l2.ch1[r]   = l2.ch0[r] + v->ne[1]*head_dim;
+            l2.scale[r] = 1.0f;
+            l2.dst[r]   = (float *) t->data;
+            l2.nb1[r]   = t->nb[1]/sizeof(float);
+            l2.nb2[r]   = t->nb[2]/sizeof(float);
+            l2.nb3[r]   = t->nb[3]/sizeof(float);
