#version 450
#include "gated_delta_net_base.glsl"

// gated delta net with a deferred state commit, see ggml_gated_delta_net_deferred. same layout and arithmetic as
// gated_delta_net.comp: replay the pending recorded rows into the base, then run the block, writing the new base when
// the block reaches it and recording the last R rows. the base may be written in place: each column is read by the
// lanes that own it before they write it.

layout(local_size_x_id = 2, local_size_y = 1, local_size_z = 1) in;

layout(push_constant) uniform Parameters {
    uint H;
    uint H_k;
    uint n_tokens;
    uint K;
    uint sq1, sq2, sq3; // q and k
    uint sv1, sv2, sv3;
    uint sg1, sg2, sg3;
    uint sb1, sb2, sb3;
    uint ss1, ss2, ss3;
    uint s_rec, rec_v, rec_g, rec_b;
    uint base_off;
    uint gates;
    float scale;
    uint q_off, k_off, v_off, g_off, b_off, s_off;
};

layout(binding = 6)            buffer RecBuf { FLOAT_TYPE data_rec[]; };
layout(binding = 7) readonly   buffer IdxBuf { int        data_idx[]; };
layout(binding = 8) readonly   buffer DtBuf  { FLOAT_TYPE data_dt[];  };
layout(binding = 9) readonly   buffer ABuf   { FLOAT_TYPE data_a[];   };
layout(binding = 10)           buffer DstBuf { FLOAT_TYPE data_dst[]; };

FLOAT_TYPE s_shard[ROWS_PER_LANE];

void gdn_step(const FLOAT_TYPE k_reg[ROWS_PER_LANE], const FLOAT_TYPE g_exp[ROWS_PER_LANE], const FLOAT_TYPE v_val, const FLOAT_TYPE beta_val) {
    FLOAT_TYPE kv_shard = 0.0;
    [[unroll]] for (uint r = 0; r < ROWS_PER_LANE; r++) {
        kv_shard += g_exp[r] * s_shard[r] * k_reg[r];
    }
    const FLOAT_TYPE kv_col = reduce_partial(kv_shard);

    const FLOAT_TYPE delta_col = (v_val - kv_col) * beta_val;

    [[unroll]] for (uint r = 0; r < ROWS_PER_LANE; r++) {
        s_shard[r] = g_exp[r] * s_shard[r] + k_reg[r] * delta_col;
    }
}

void main() {
    const uint head_id = gl_WorkGroupID.x;
    const uint seq_id  = gl_WorkGroupID.y;
    const uint lane    = gl_SubgroupInvocationID % LANES_PER_COLUMN;
    const uint col     = gl_WorkGroupID.z * COLS_PER_WG + (gl_SubgroupInvocationID / LANES_PER_COLUMN);

    const uint hk = head_id % H_k;
    const uint G  = KDA == 0 ? 1 : S_V;

    const uint s_base = s_off + seq_id * ss3 + head_id * ss2 + col * ss1;
    [[unroll]] for (uint r = 0; r < ROWS_PER_LANE; r++) {
        s_shard[r] = FLOAT_TYPE(data_state[s_base + r * LANES_PER_COLUMN + lane]);
    }

    const uint pending = uint(clamp(data_idx[3 * seq_id], 0, int(K)));
    const uint rin     = uint(data_idx[3 * seq_id + 1]) * s_rec;
    const uint rout    = uint(data_idx[3 * seq_id + 2]) * s_rec;

    FLOAT_TYPE k_reg[ROWS_PER_LANE];
    FLOAT_TYPE q_reg[ROWS_PER_LANE];
    FLOAT_TYPE g_exp[ROWS_PER_LANE];

    for (uint p = 0; p < pending; p++) {
        [[unroll]] for (uint r = 0; r < ROWS_PER_LANE; r++) {
            k_reg[r] = data_rec[rin + (p * H_k + hk) * S_V + r * LANES_PER_COLUMN + lane];
        }
        const uint g_base = rin + rec_g + (p * H + head_id) * G;
        if (KDA == 0) {
            const FLOAT_TYPE ge = exp(data_rec[g_base]);
            [[unroll]] for (uint r = 0; r < ROWS_PER_LANE; r++) {
                g_exp[r] = ge;
            }
        } else {
            [[unroll]] for (uint r = 0; r < ROWS_PER_LANE; r++) {
                g_exp[r] = exp(data_rec[g_base + r * LANES_PER_COLUMN + lane]);
            }
        }
        gdn_step(k_reg, g_exp, data_rec[rin + rec_v + (p * H + head_id) * S_V + col], data_rec[rin + rec_b + p * H + head_id]);
    }

    const uint R      = min(n_tokens, K);
    const uint t_base = n_tokens - R;

    const uint base_base = base_off + (seq_id * H + head_id) * S_V * S_V + col * S_V;
    uint attn_off = (seq_id * n_tokens * H + head_id) * S_V;

    const FLOAT_TYPE dt_h = gates != 0 ? data_dt[head_id] : FLOAT_TYPE(0.0);
    const FLOAT_TYPE a_h  = gates != 0 ? data_a[head_id]  : FLOAT_TYPE(0.0);

    for (uint t = 0; t < n_tokens; t++) {
        if (t == t_base) {
            [[unroll]] for (uint r = 0; r < ROWS_PER_LANE; r++) {
                data_dst[base_base + r * LANES_PER_COLUMN + lane] = s_shard[r];
            }
        }

        const uint qo = q_off + seq_id * sq3 + t * sq2 + hk * sq1;
        const uint ko = k_off + seq_id * sq3 + t * sq2 + hk * sq1;
        const uint vo = v_off + seq_id * sv3 + t * sv2 + head_id * sv1;
        const uint go = g_off + seq_id * sg3 + t * sg2 + head_id * sg1;

        [[unroll]] for (uint r = 0; r < ROWS_PER_LANE; r++) {
            const uint i = r * LANES_PER_COLUMN + lane;
            k_reg[r] = FLOAT_TYPE(data_k[ko + i]);
            q_reg[r] = FLOAT_TYPE(data_q[qo + i]);
        }

        const FLOAT_TYPE v_val = FLOAT_TYPE(data_v[vo + col]);

        // raw gates (gates != 0): g = softplus(g + dt) * a, beta = sigmoid(beta)
        FLOAT_TYPE beta_val = FLOAT_TYPE(data_beta[b_off + seq_id * sb3 + t * sb2 + head_id * sb1]);
        FLOAT_TYPE g_val    = FLOAT_TYPE(data_g[go]);
        if (gates != 0) {
            const FLOAT_TYPE x = g_val + dt_h;
            g_val    = ((x > 20.0) ? x : log(1.0 + exp(x))) * a_h;
            beta_val = 1.0 / (1.0 + exp(-beta_val));
        }

        if (KDA == 0) {
            const FLOAT_TYPE ge = exp(g_val);
            [[unroll]] for (uint r = 0; r < ROWS_PER_LANE; r++) {
                g_exp[r] = ge;
            }
        } else {
            [[unroll]] for (uint r = 0; r < ROWS_PER_LANE; r++) {
                g_exp[r] = exp(FLOAT_TYPE(data_g[go + r * LANES_PER_COLUMN + lane]));
            }
        }

        if (t >= t_base) {
            const uint rr = t - t_base;
            if (head_id < H_k && col == 0) {
                [[unroll]] for (uint r = 0; r < ROWS_PER_LANE; r++) {
                    data_rec[rout + (rr * H_k + head_id) * S_V + r * LANES_PER_COLUMN + lane] = k_reg[r];
                }
            }
            if (lane == 0) {
                data_rec[rout + rec_v + (rr * H + head_id) * S_V + col] = v_val;
            }
            if (col == 0) {
                if (KDA == 0) {
                    if (lane == 0) {
                        data_rec[rout + rec_g + rr * H + head_id] = g_val;
                    }
                } else {
                    [[unroll]] for (uint r = 0; r < ROWS_PER_LANE; r++) {
                        const uint i = r * LANES_PER_COLUMN + lane;
                        data_rec[rout + rec_g + (rr * H + head_id) * G + i] = FLOAT_TYPE(data_g[go + i]);
                    }
                }
                if (lane == 0) {
                    data_rec[rout + rec_b + rr * H + head_id] = beta_val;
                }
            }
        }

        gdn_step(k_reg, g_exp, v_val, beta_val);

        FLOAT_TYPE attn_partial = 0.0;
        [[unroll]] for (uint r = 0; r < ROWS_PER_LANE; r++) {
            attn_partial += s_shard[r] * q_reg[r];
        }
        const FLOAT_TYPE attn_col = reduce_partial(attn_partial);

        if (lane == 0) {
            data_dst[attn_off + col] = attn_col * scale;
        }

        attn_off += S_V * H;
    }
}
