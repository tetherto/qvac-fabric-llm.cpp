#version 450

// Inkling 2's depth mix in one pass, one workgroup per token: for each query, softmax over the states of
// scale * dot(state, query), then the weighted sum of the states, written as [n_embd, n_queries, n_tokens].
// The states are a stack and an optional last state, which the pass can RMS-normalize as rms_norm.comp does.

#extension GL_EXT_control_flow_attributes : enable
#extension GL_KHR_shader_subgroup_arithmetic : enable
#extension GL_KHR_shader_subgroup_basic : enable

layout(constant_id = 0) const uint BLOCK_SIZE = 512;
layout(constant_id = 1) const uint NUM_SUBGROUPS = 8;
layout(constant_id = 2) const uint MAX_STATES = 8;
layout(constant_id = 3) const uint MAX_QUERIES = 4;
// channel steps per invocation whose states stay in registers between the two passes
layout(constant_id = 4) const uint CACHED_STEPS = 5;
// the last state after the stack: none, read as is, or RMS-normalized here
layout(constant_id = 5) const uint LAST_MODE = 0;

const uint LAST_NONE = 0;
const uint LAST_NORM = 2;

layout(local_size_x_id = 0, local_size_y = 1, local_size_z = 1) in;

layout(binding = 0) readonly buffer S { float stack[]; };    // [n_embd, n_stack, n_tokens]
layout(binding = 1) readonly buffer L { float last[]; };     // [n_embd, 1, n_tokens]
layout(binding = 2) readonly buffer Q { float queries[]; };  // [n_embd, n_queries]
layout(binding = 3) writeonly buffer D { float dst[]; };     // [n_embd, n_queries, n_tokens]

layout(push_constant) uniform PushConstants {
    uint n_embd;
    uint n_stack;
    uint n_queries;
    float scale;
    float eps;
};

shared float partial[MAX_QUERIES * MAX_STATES * NUM_SUBGROUPS];
shared float norm_partial[NUM_SUBGROUPS];

uint n_states() {
    return n_stack + (LAST_MODE == LAST_NONE ? 0 : 1);
}

// every load of channel e before any arithmetic, from clamped addresses; stack slots past n_stack are 0
void load_channel(const uint s_base, const uint l_base, const uint e, out float s[MAX_STATES], out float x, out float w[MAX_QUERIES]) {
    const uint c = min(e, n_embd - 1);
    [[unroll]] for (uint n = 0; n < MAX_STATES; ++n) {
        const float v = stack[s_base + min(n, n_stack - 1) * n_embd + c];
        s[n] = n < n_stack ? v : 0.0f;
    }
    x = LAST_MODE == LAST_NONE ? 0.0f : last[l_base + c];
    [[unroll]] for (uint q = 0; q < MAX_QUERIES; ++q) {
        w[q] = queries[min(q, n_queries - 1) * n_embd + c];
    }
}

// rms_norm.comp's sum of squares of the last state, over the cached steps and the channels past them
float last_sum_of_squares(const float x[CACHED_STEPS], const uint l_base, const uint tid) {
    float sum = 0.0f;
    [[unroll]] for (uint i = 0; i < CACHED_STEPS; ++i) {
        float xi = 0.0f;
        if (i * BLOCK_SIZE + tid < n_embd) {
            xi = x[i];
        }
        sum += xi * xi;
    }
    for (uint e = CACHED_STEPS * BLOCK_SIZE + tid; e < n_embd; e += BLOCK_SIZE) {
        const float xi = last[l_base + e];
        sum += xi * xi;
    }
    return sum;
}

// rms_norm.comp's subgroup path: the same sums in the same order, then the same scale
float last_norm_scale(const float x[CACHED_STEPS], const uint l_base, const uint tid) {
    float sum = subgroupAdd(last_sum_of_squares(x, l_base, tid));
    if (subgroupElect()) {
        norm_partial[gl_SubgroupID] = sum;
    }
    barrier();
    sum = 0.0f;
    if (gl_NumSubgroups <= 4) {
        for (uint i = 0; i < gl_NumSubgroups; ++i) {
            sum += norm_partial[i];
        }
    } else {
        for (uint i = gl_SubgroupInvocationID; i < gl_NumSubgroups; i += gl_SubgroupSize) {
            sum += norm_partial[i];
        }
        sum = subgroupAdd(sum);
    }
    const float mean = sum / float(n_embd);
    return inversesqrt(mean + eps);
}

float last_value(const float x, const float norm_scale) {
    return LAST_MODE == LAST_NORM ? norm_scale * x : x;
}

void accumulate_stack(const float s[MAX_STATES], const float w[MAX_QUERIES], inout float acc[MAX_QUERIES][MAX_STATES]) {
    [[unroll]] for (uint q = 0; q < MAX_QUERIES; ++q) {
        if (q < n_queries) {
            [[unroll]] for (uint n = 0; n < MAX_STATES; ++n) {
                acc[q][n] += s[n] * w[q];
            }
        }
    }
}

void accumulate_last(const float v, const float w[MAX_QUERIES], inout float acc_last[MAX_QUERIES]) {
    [[unroll]] for (uint q = 0; q < MAX_QUERIES; ++q) {
        if (q < n_queries) {
            acc_last[q] += v * w[q];
        }
    }
}

void store_partial(const uint q, const uint n, const float v) {
    const float r = subgroupAdd(v);
    if (subgroupElect()) {
        partial[(q * MAX_STATES + n) * NUM_SUBGROUPS + gl_SubgroupID] = r;
    }
}

// the subgroup sums of the stack's scores, one slot per subgroup
void store_stack_scores(const float acc[MAX_QUERIES][MAX_STATES]) {
    [[unroll]] for (uint q = 0; q < MAX_QUERIES; ++q) {
        [[unroll]] for (uint n = 0; n < MAX_STATES; ++n) {
            if (q < n_queries && n < n_stack) {
                store_partial(q, n, acc[q][n]);
            }
        }
    }
}

// the last state's scores go in slot n_stack
void store_last_scores(const float acc_last[MAX_QUERIES]) {
    [[unroll]] for (uint q = 0; q < MAX_QUERIES; ++q) {
        if (q < n_queries) {
            store_partial(q, n_stack, acc_last[q]);
        }
    }
}

// the subgroup sums of a score in subgroup order
float score(const uint q, const uint n) {
    float sum = 0.0f;
    [[unroll]] for (uint sg = 0; sg < NUM_SUBGROUPS; ++sg) {
        sum += partial[(q * MAX_STATES + n) * NUM_SUBGROUPS + sg];
    }
    return scale * sum;
}

// as soft_max: exp(x - max), then times 1/sum. Every invocation computes the weights, so no barrier follows.
void softmax_weights(const uint q, out float p[MAX_STATES]) {
    float x[MAX_STATES];
    [[unroll]] for (uint n = 0; n < MAX_STATES; ++n) {
        const float v = score(q, n);
        x[n] = n < n_states() ? v : 0.0f;
    }
    float m = x[0];
    [[unroll]] for (uint n = 1; n < MAX_STATES; ++n) {
        if (n < n_states()) {
            m = max(m, x[n]);
        }
    }
    float sum = 0.0f;
    [[unroll]] for (uint n = 0; n < MAX_STATES; ++n) {
        if (n < n_states()) {
            x[n] = exp(x[n] - m);
            sum += x[n];
        }
    }
    const float inv_sum = 1.0f / sum;
    [[unroll]] for (uint n = 0; n < MAX_STATES; ++n) {
        p[n] = n < n_states() ? x[n] * inv_sum : 0.0f;
    }
}

float weight_of_last(const float p[MAX_STATES]) {
    float r = 0.0f;
    [[unroll]] for (uint n = 0; n < MAX_STATES; ++n) {
        if (n == n_stack) {
            r = p[n];
        }
    }
    return r;
}

void all_weights(out float p[MAX_QUERIES][MAX_STATES], out float p_last[MAX_QUERIES]) {
    [[unroll]] for (uint q = 0; q < MAX_QUERIES; ++q) {
        p_last[q] = 0.0f;
        if (q < n_queries) {
            softmax_weights(q, p[q]);
            p_last[q] = weight_of_last(p[q]);
        }
    }
}

// the stack terms in state order, then the last state's: the stack's zero slots add nothing
void store_mix(const float s[MAX_STATES], const float v, const float p[MAX_QUERIES][MAX_STATES], const float p_last[MAX_QUERIES],
               const uint d_base, const uint e) {
    [[unroll]] for (uint q = 0; q < MAX_QUERIES; ++q) {
        if (q < n_queries) {
            float o = 0.0f;
            [[unroll]] for (uint n = 0; n < MAX_STATES; ++n) {
                o += p[q][n] * s[n];
            }
            if (LAST_MODE != LAST_NONE) {
                o += p_last[q] * v;
            }
            dst[d_base + q * n_embd + e] = o;
        }
    }
}

// the token's offsets into the stack, the last state and dst, and the invocation
struct Token {
    uint s_base;
    uint l_base;
    uint d_base;
    uint tid;
};

void load_cached(const Token k, out float s[CACHED_STEPS][MAX_STATES], out float x[CACHED_STEPS], out float w[CACHED_STEPS][MAX_QUERIES]) {
    [[unroll]] for (uint i = 0; i < CACHED_STEPS; ++i) {
        load_channel(k.s_base, k.l_base, i * BLOCK_SIZE + k.tid, s[i], x[i], w[i]);
    }
}

void clear_scores(out float acc[MAX_QUERIES][MAX_STATES], out float acc_last[MAX_QUERIES]) {
    [[unroll]] for (uint q = 0; q < MAX_QUERIES; ++q) {
        acc_last[q] = 0.0f;
        [[unroll]] for (uint n = 0; n < MAX_STATES; ++n) {
            acc[q][n] = 0.0f;
        }
    }
}

// the stack's dot products in channel order: the cached steps, then the channels past them
void stack_scores(const Token k, const float s[CACHED_STEPS][MAX_STATES], const float w[CACHED_STEPS][MAX_QUERIES],
                  inout float acc[MAX_QUERIES][MAX_STATES]) {
    [[unroll]] for (uint i = 0; i < CACHED_STEPS; ++i) {
        if (i * BLOCK_SIZE + k.tid < n_embd) {
            accumulate_stack(s[i], w[i], acc);
        }
    }
    for (uint e = CACHED_STEPS * BLOCK_SIZE + k.tid; e < n_embd; e += BLOCK_SIZE) {
        float r[MAX_STATES];
        float rx;
        float rw[MAX_QUERIES];
        load_channel(k.s_base, k.l_base, e, r, rx, rw);
        accumulate_stack(r, rw, acc);
    }
}

// the last state's dot products in channel order, the cached values turned into the state as they go
void last_scores(const Token k, const float norm_scale, inout float x[CACHED_STEPS], const float w[CACHED_STEPS][MAX_QUERIES],
                 inout float acc_last[MAX_QUERIES]) {
    [[unroll]] for (uint i = 0; i < CACHED_STEPS; ++i) {
        x[i] = last_value(x[i], norm_scale);
        if (i * BLOCK_SIZE + k.tid < n_embd) {
            accumulate_last(x[i], w[i], acc_last);
        }
    }
    for (uint e = CACHED_STEPS * BLOCK_SIZE + k.tid; e < n_embd; e += BLOCK_SIZE) {
        float r[MAX_STATES];
        float rx;
        float rw[MAX_QUERIES];
        load_channel(k.s_base, k.l_base, e, r, rx, rw);
        accumulate_last(last_value(rx, norm_scale), rw, acc_last);
    }
}

void store_all(const Token k, const float norm_scale, const float s[CACHED_STEPS][MAX_STATES], const float x[CACHED_STEPS],
               const float p[MAX_QUERIES][MAX_STATES], const float p_last[MAX_QUERIES]) {
    [[unroll]] for (uint i = 0; i < CACHED_STEPS; ++i) {
        const uint e = i * BLOCK_SIZE + k.tid;
        if (e < n_embd) {
            store_mix(s[i], x[i], p, p_last, k.d_base, e);
        }
    }
    for (uint e = CACHED_STEPS * BLOCK_SIZE + k.tid; e < n_embd; e += BLOCK_SIZE) {
        float r[MAX_STATES];
        float rx;
        float rw[MAX_QUERIES];
        load_channel(k.s_base, k.l_base, e, r, rx, rw);
        store_mix(r, last_value(rx, norm_scale), p, p_last, k.d_base, e);
    }
}

void main() {
    const uint t = gl_WorkGroupID.x;
    const Token k = Token(t * n_stack * n_embd, t * n_embd, t * n_queries * n_embd, gl_LocalInvocationID.x);

    float s[CACHED_STEPS][MAX_STATES];
    float x[CACHED_STEPS];
    float w[CACHED_STEPS][MAX_QUERIES];
    load_cached(k, s, x, w);

    float acc[MAX_QUERIES][MAX_STATES];
    float acc_last[MAX_QUERIES];
    clear_scores(acc, acc_last);
    stack_scores(k, s, w, acc);
    store_stack_scores(acc);

    // the last state's scores wait for its norm
    float norm_scale = 1.0f;
    if (LAST_MODE == LAST_NORM) {
        norm_scale = last_norm_scale(x, k.l_base, k.tid);
    }
    if (LAST_MODE != LAST_NONE) {
        last_scores(k, norm_scale, x, w, acc_last);
        store_last_scores(acc_last);
    }
    barrier();

    float p[MAX_QUERIES][MAX_STATES];
    float p_last[MAX_QUERIES];
    all_weights(p, p_last);
    store_all(k, norm_scale, s, x, p, p_last);
}
