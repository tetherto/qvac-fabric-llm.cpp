#version 450

#include "generic_head.glsl"
#include "types.glsl"

#extension GL_EXT_control_flow_attributes : enable

layout(local_size_x_id = 0, local_size_y = 1, local_size_z = 1) in;

layout (binding = 0) readonly buffer A {A_TYPE data_a[];};
layout (binding = 1) writeonly buffer D {D_TYPE data_d[];};

layout (constant_id = 0) const uint BLOCK_SIZE = 32;

// below the key of every value that is not NaN
const uint KEY_NONE = 0;

shared uint tmpkey[BLOCK_SIZE];
shared uint tmp[BLOCK_SIZE];
shared uint row_has_nan;

bool is_nan_bits(const uint bits) {
    return (bits & 0x7FFFFFFFu) > 0x7F800000u;
}

// compares like the float, with -0.0 equal to +0.0: integer compares hold without NaN/Inf-preserving float controls
uint order_key(const uint bits) {
    const uint b = bits == 0x80000000u ? 0u : bits;
    return (b & 0x80000000u) != 0 ? ~b : b | 0x80000000u;
}

// the CPU loop: a NaN restarts its running maximum, so a row with a NaN is scanned in order by one thread
uint argmax_in_order(const uint row) {
    uint kmax = KEY_NONE;
    uint acol = 0;
    bool restart = false;
    for (uint i = 0; i < p.KX; ++i) {
        const uint bits = floatBitsToUint(float(data_a[row*p.KX + i]));
        if (is_nan_bits(bits)) {
            restart = true;
        } else if (restart || order_key(bits) >= kmax) {
            kmax = order_key(bits);
            acol = i;
            restart = false;
        }
    }
    return acol;
}

// the last maximum of this thread's stride of the row; returns whether the stride holds a NaN
bool scan_stride(const uint row, const uint col, out uint kmax, out uint acol) {
    kmax = KEY_NONE;
    acol = 0;
    bool has_nan = false;
    for (uint i = col; i < p.KX; i += BLOCK_SIZE) {
        const uint bits = floatBitsToUint(float(data_a[row*p.KX + i]));
        if (is_nan_bits(bits)) {
            has_nan = true;
        } else if (order_key(bits) >= kmax) {
            kmax = order_key(bits);
            acol = i;
        }
    }
    return has_nan;
}

// equal maxima keep the larger index
void reduce_strides(const uint col) {
    [[unroll]] for (int s = int(BLOCK_SIZE) / 2; s > 0; s >>= 1) {
        if (col < s) {
            const uint other = tmpkey[col + s];
            if (other > tmpkey[col] || (other == tmpkey[col] && tmp[col + s] > tmp[col])) {
                tmpkey[col] = other;
                tmp[col] = tmp[col + s];
            }
        }
        barrier();
    }
}

// the index of the last maximum of the row, as the CPU backend returns it
void main() {
    const uint row = gl_WorkGroupID.z * 262144 + gl_WorkGroupID.y * 512 + gl_WorkGroupID.x;
    const uint col = gl_LocalInvocationID.x;

    if (row >= p.KY) {
        return;
    }

    if (col == 0) {
        row_has_nan = 0;
    }
    barrier();

    uint kmax;
    uint acol;
    if (scan_stride(row, col, kmax, acol)) {
        atomicOr(row_has_nan, 1);
    }
    tmpkey[col] = kmax;
    tmp[col] = acol;
    barrier();

    reduce_strides(col);

    if (col == 0) {
        data_d[row] = D_TYPE(row_has_nan != 0 ? argmax_in_order(row) : tmp[0]);
    }
}
