# The shared core owns libc++; CUDA and XDNA retain their GNU runtimes.
function(qvac_configure_shared_core_runtime)
    if(NOT CMAKE_SYSTEM_NAME STREQUAL "Linux" OR NOT CMAKE_CXX_COMPILER_ID MATCHES "Clang")
        message(FATAL_ERROR "qvac-fabric shared core on Linux requires Clang/libc++")
    endif()
    execute_process(COMMAND "${CMAKE_CXX_COMPILER}" -stdlib=libc++ -print-file-name=libc++.a
        OUTPUT_VARIABLE archive OUTPUT_STRIP_TRAILING_WHITESPACE
        COMMAND_ERROR_IS_FATAL ANY)
    if(NOT IS_ABSOLUTE "${archive}" OR NOT EXISTS "${archive}")
        message(FATAL_ERROR "qvac-fabric shared core: libc++.a not found: ${archive}")
    endif()
    target_link_options(ggml-base PRIVATE -stdlib=libc++ -nostdlib++ LINKER:--as-needed)
    target_link_libraries(ggml-base PRIVATE "$<LINK_LIBRARY:WHOLE_ARCHIVE,${archive}>")
    set(exports "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/shared-core.map")
    target_link_options(ggml-base PRIVATE "LINKER:--version-script=${exports}" LINKER:-z,defs)
    set_property(TARGET ggml-base APPEND PROPERTY LINK_DEPENDS "${exports}")

    set(clients ggml)
    if(TARGET ggml-vector-index)
        list(APPEND clients ggml-vector-index)
    endif()
    foreach(backend IN LISTS GGML_AVAILABLE_BACKENDS)
        if(NOT backend MATCHES "^ggml-(cuda|xdna)$")
            list(APPEND clients ${backend})
        endif()
    endforeach()
    foreach(client IN LISTS clients)
        target_link_options(${client} PRIVATE -stdlib=libc++ -nostdlib++ LINKER:-z,defs LINKER:--as-needed)
        if(client STREQUAL "ggml")
            set(surface "ggml_backend_*")
            set(node "QVAC_GGML_REGISTRY_ABI_1")
        elseif(client STREQUAL "ggml-vector-index")
            set(surface "ggml_vec_index_*")
            set(node "QVAC_GGML_VECTOR_INDEX_ABI_1")
        else()
            set(surface "ggml_backend_init; ggml_backend_score")
            set(node "")
        endif()
        set(map "${CMAKE_CURRENT_BINARY_DIR}/${client}-shared-core.map")
        file(WRITE "${map}" "${node} { global: ${surface}; local: *; };\n")
        target_link_options(${client} PRIVATE "LINKER:--version-script=${map}")
        set_property(TARGET ${client} APPEND PROPERTY LINK_DEPENDS "${map}")
        # Set after each backend's own RPATH setup.
        set_target_properties(${client} PROPERTIES INSTALL_RPATH "$ORIGIN" BUILD_WITH_INSTALL_RPATH ON)
    endforeach()
endfunction()
