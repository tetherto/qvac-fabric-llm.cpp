prefix=@GGML_PC_PREFIX@
exec_prefix=${prefix}
libdir=@GGML_PC_LIBDIR@
includedir=@GGML_PC_INCLUDEDIR@

Name: ggml
Description: Tensor library for machine learning
Version: @GGML_VERSION@
Libs: -L${libdir} -l@GGML_LIB_OUTPUT_PREFIX@ggml -l@GGML_LIB_OUTPUT_PREFIX@ggml-base
Libs.private: @GGML_PC_LIBS_PRIVATE@
Cflags: -I${includedir}
