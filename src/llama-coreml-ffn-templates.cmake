set(_ffn_header "${CMAKE_CURRENT_BINARY_DIR}/llama-coreml-ffn-templates.inc")
file(WRITE "${_ffn_header}" "// Generated from the bundled Core ML FFN templates.\n")
foreach(_channels 4608 6144)
    foreach(_file model.mlmodel Manifest.json layout.txt)
        set(_source "${CMAKE_CURRENT_SOURCE_DIR}/llama-coreml-ffn-templates/int8-c${_channels}/${_file}")
        set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${_source}")
        file(READ "${_source}" _bytes HEX)
        string(REGEX REPLACE "(..)" "0x\\1," _bytes "${_bytes}")
        string(MAKE_C_IDENTIFIER "ffn_${_channels}_${_file}" _symbol)
        file(APPEND "${_ffn_header}" "static const unsigned char ${_symbol}[] = {${_bytes}};\n")
    endforeach()
endforeach()
